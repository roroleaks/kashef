# ==============================================================================
# Kashef (كاشف) — Environment Configuration Template
# Copy this file to .env.local to configure your local deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Engine B: Server-Side LLM Classifier
# ------------------------------------------------------------------------------
# Kashef supports zero-data-retention language model evaluation via Google Gemini
# or any OpenAI-compatible API endpoint.
# When unconfigured, Kashef operates strictly via Engine A (in-memory statistical proxies).

# Primary Provider: Google Gemini API (Recommended)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Model name (defaults to gemini-2.0-flash)
# Supported options: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Alternative Provider: OpenAI or OpenAI-Compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Network & Proxy Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to trust client IP headers (CF-Connecting-IP, X-Real-IP, X-Forwarded-For)
# Set to 'false' if running directly exposed without a reverse proxy. Default: true
KASHEF_TRUST_PROXY_HEADERS=true
